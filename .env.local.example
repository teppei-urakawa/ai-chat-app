# GitHub OAuth（完全無料・カード不要）
# https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js secret: openssl rand -base64 32 で生成
AUTH_SECRET=

# Groq API（完全無料・カード不要）
# https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=

# ローカルDB: postgresql://postgres:postgres@localhost:5432/ai_chat
# 本番DB: Supabase https://supabase.com → カード不要の無料枠
DATABASE_URL=

NEXTAUTH_URL=http://localhost:3000
