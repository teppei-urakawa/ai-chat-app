# GitHub OAuth (https://github.com/settings/developers)
# New OAuth App → Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js secret: openssl rand -base64 32 で生成
AUTH_SECRET=

# Supabase PostgreSQL (https://supabase.com → Project Settings → Database)
# または ローカル開発: postgresql://postgres:postgres@localhost:5432/ai_chat
DATABASE_URL=

# Google Gemini API (https://aistudio.google.com/app/apikey) ← 課金設定不要
GOOGLE_GENERATIVE_AI_API_KEY=

NEXTAUTH_URL=http://localhost:3000
